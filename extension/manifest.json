{
  "manifest_version": 3,
  "name": "Echo360 Online Subtitle Translator",
  "version": "0.1.0",
  "description": "Fetch Echo360 VTT, translate it, and mount translated subtitles.",
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "*://canvas.sydney.edu.au/*",
    "*://echo360.org/*",
    "*://*.echo360.org/*",
    "*://echo360.com/*",
    "*://*.echo360.com/*",
    "*://echo360.net.au/*",
    "*://*.echo360.net.au/*",
    "*://echo360.net/*",
    "*://*.echo360.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://canvas.sydney.edu.au/*",
        "*://echo360.org/*",
        "*://*.echo360.org/*",
        "*://echo360.com/*",
        "*://*.echo360.com/*",
        "*://echo360.net.au/*",
        "*://*.echo360.net.au/*",
        "*://echo360.net/*",
        "*://*.echo360.net/*"
      ],
      "all_frames": true,
      "js": [
        "page_probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://canvas.sydney.edu.au/*",
        "*://echo360.org/*",
        "*://*.echo360.org/*",
        "*://echo360.com/*",
        "*://*.echo360.com/*",
        "*://echo360.net.au/*",
        "*://*.echo360.net.au/*",
        "*://echo360.net/*",
        "*://*.echo360.net/*"
      ],
      "all_frames": true,
      "js": [
        "constants.js",
        "vtt.js",
        "storage.js",
        "video.js",
        "source_finder.js",
        "renderer.js",
        "ui.js",
        "backend_client.js",
        "translation_service.js",
        "controller.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
